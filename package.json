{
  "name": "mobile",
  "version": "1.25.2",
  "main": "index.ts",
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "^5.2.0",
    "@react-navigation/bottom-tabs": "^7.18.2",
    "@react-navigation/drawer": "^7.12.2",
    "@react-navigation/native": "^7.3.3",
    "expo": "~56.0.12",
    "expo-audio": "~56.0.12",
    "expo-auth-session": "~56.0.15",
    "expo-crypto": "~56.0.4",
    "expo-file-system": "^56.0.8",
    "expo-keep-awake": "^56.0.3",
    "expo-screen-orientation": "~56.0.5",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "^56.0.18",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-web-browser": "~56.0.5",
    "lucide-react-native": "^1.21.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-ble-plx": "^3.5.1",
    "react-native-gesture-handler": "^3.0.1",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.25.2",
    "react-native-sensors": "^7.3.6",
    "react-native-svg": "^15.15.5",
    "react-native-view-shot": "^5.1.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "jest": "^30.4.2",
    "patch-package": "^8.0.1",
    "ts-jest": "^29.4.11",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:release": "expo prebuild -p android --no-install && expo run:android --variant release",
    "android:apk": "expo prebuild -p android --no-install && cd android && ./gradlew assembleRelease",
    "android:bundle": "expo prebuild -p android --no-install && cd android && ./gradlew bundleRelease",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "images:gen": "node scripts/gen-exercise-images.js",
    "postinstall": "patch-package"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src/__tests__"
    ],
    "moduleNameMapper": {
      "^@shared/(.*)$": "<rootDir>/../shared/$1"
    },
    "globals": {
      "ts-jest": {
        "diagnostics": false
      }
    }
  },
  "private": true
}
