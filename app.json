{
  "expo": {
    "name": "Hit Tracker",
    "slug": "hit-tracker",
    "scheme": ["hittracker", "com.googleusercontent.apps.979133969928-70eio2up7nsov07ve4bckqqhcdq5pksr"],
    "version": "1.26.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "userInterfaceStyle": "dark",
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#000000",
      "translucent": false
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./resources/android/res/mipmap-xxxhdpi/ic_launcher_foreground.png",
        "backgroundImage": "./resources/android/res/mipmap-xxxhdpi/ic_launcher_background.png",
        "monochromeImage": "./resources/android/res/mipmap-xxxhdpi/ic_launcher_monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hittracker.app",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 288,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-audio",
      "./plugins/withArmOnly",
      "./plugins/withReleaseSigning",
      "expo-web-browser",
      "expo-secure-store"
    ]
  }
}
