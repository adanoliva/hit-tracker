{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0f0f0f",
      "translucent": false
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "../resources/android/res/mipmap-xxxhdpi/ic_launcher_foreground.png",
        "backgroundImage": "../resources/android/res/mipmap-xxxhdpi/ic_launcher_background.png",
        "monochromeImage": "../resources/android/res/mipmap-xxxhdpi/ic_launcher_monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hittracker.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
